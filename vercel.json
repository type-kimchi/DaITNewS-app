{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } }
  ],
  "routes": [
    { "src": "/api/articles/(?<id>[^/]+)", "dest": "/api/index.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/static/(.*)", "dest": "/client/static/$1" },
    { "src": "/manifest.json", "dest": "/client/manifest.json" },
    { "src": "/robots.txt", "dest": "/client/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/client/sitemap.xml" },
    { "src": "/favicon.ico", "dest": "/client/favicon.ico" },
    { "src": "/privacy/?", "dest": "/client/blindtype/privacy/index.html" },
    { "src": "/terms/?", "dest": "/client/blindtype/terms/index.html" },
    { "src": "/delete-account/?", "dest": "/client/blindtype/delete-account/index.html" },
    { "src": "/community-guidelines/?", "dest": "/client/blindtype/community-guidelines/index.html" },
    { "src": "/child-safety-standards/?", "dest": "/client/blindtype/child-safety-standards/index.html" },
    { "src": "/blindtype/?", "dest": "/client/blindtype/index.html" },
    { "src": "/blindtype/privacy/?", "dest": "/client/blindtype/privacy/index.html" },
    { "src": "/blindtype/terms/?", "dest": "/client/blindtype/terms/index.html" },
    { "src": "/blindtype/delete-account/?", "dest": "/client/blindtype/delete-account/index.html" },
    { "src": "/blindtype/community-guidelines/?", "dest": "/client/blindtype/community-guidelines/index.html" },
    { "src": "/blindtype/child-safety-standards/?", "dest": "/client/blindtype/child-safety-standards/index.html" },
    { "src": "/blindtype/assets/(.*)", "dest": "/client/blindtype/assets/$1" },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json))", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ],
  "installCommand": "npm install --prefix client --force && npm install --prefix api --force && npm install --force"
}
